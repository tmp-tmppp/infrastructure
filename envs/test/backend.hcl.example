# Copy to backend.hcl (ignored by Git) and fill in the storage account name from the bootstrap.
# Names only: no keys, tokens or IDs belong here. The key differs from envs/prod: never set it to
# prod.terraform.tfstate, or this configuration would plan against the state of RSO-ekipa10.
resource_group_name  = "rso-tfstate-rg"
storage_account_name = "<state-storage-account-name>"
container_name       = "tfstate"
key                  = "test.terraform.tfstate"
